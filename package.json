{
  "name": "nebula-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "description": "AI-native Enterprise Resource Planning Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "prettier": "^3.6.2",
    "@types/node": "^24.3.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10"
  }
}
